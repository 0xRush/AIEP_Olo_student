# OS
.DS_Store
__MACOSX/
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Lab-generated output — students regenerate these locally, never commit them
**/artefacts/
**/cache/
**/runs/
**/lightning_logs/
**/wandb/

# Trained model weights produced by labs (the committed fixtures live in shared/data_cache)
**/artefacts/*.pt
**/artefacts/*.pth
**/artefacts/*.joblib
**/artefacts/*.pkl

# Large datasets — these come from GitHub Releases via tools/fetch_datasets.py.
# Small committed fixtures under shared/data_cache are re-included below.
shared/data_cache/*
!shared/data_cache/README.md
!shared/data_cache/.gitattributes
!shared/data_cache/*.csv
!shared/data_cache/*.parquet
!shared/data_cache/*.json
!shared/data_cache/*.md

# Hugging Face / torch model caches
.cache/
**/hf_cache/
**/torch_cache/

# Secrets — never commit an API key
.env
.env.*
!.env.example
*.pem
*.key

# Held-out assessment data (A3 test set). Instructor-only, kept outside git.
_holdout/

# Editors
.vscode/
.idea/
*.swp
*.swo

# Source PDFs for theory sessions. The ledger records where each one came from;
# the binaries themselves stay out of git. Put them in slides/sources/<session>/.
week_*/slides/sources/

# Theory pipeline output — regenerate with `make theory-all`.
# The Arabic slide scripts (slides/*.ar.md) and source ledgers (slides/*.sources.md)
# ARE text and ARE committed; the Word and PowerPoint files they build are not.
theory_docx/
theory_pptx/
*.docx
*.pptx
*.potx

# Archives / build output
*.zip
*.tar.gz
dist/
build/

# The generated student repo lives outside this tree, but guard against a stray copy
_student_repo/
