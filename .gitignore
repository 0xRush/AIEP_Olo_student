# OS
.DS_Store
__MACOSX/
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Lab-generated output — students regenerate these locally, never commit them
**/artefacts/
**/cache/
**/runs/
**/lightning_logs/
**/wandb/

# Trained model weights produced by labs (the committed fixtures live in shared/data_cache)
**/artefacts/*.pt
**/artefacts/*.pth
**/artefacts/*.joblib
**/artefacts/*.pkl

# Large datasets — these come from GitHub Releases via tools/fetch_datasets.py.
# Small committed fixtures under shared/data_cache are re-included below.
shared/data_cache/*
!shared/data_cache/README.md
!shared/data_cache/.gitattributes
!shared/data_cache/*.csv
!shared/data_cache/*.parquet
!shared/data_cache/*.json
!shared/data_cache/*.md
# ...except the ones that belong in a release. The *.parquet whitelist above assumes a
# fixture is small; sentence_embeddings_sample is 78 MB, and shared/datasets.yaml already
# points at the data-v1 release asset for it. Weeks 1-4's big fixtures are .zip, which
# line 79 already excludes, so this is the first parquet to defeat the rule.
shared/data_cache/sentence_embeddings_sample.parquet

# ...and the reverse case. The .zip exclusion assumes a zip is a big image archive, and
# for five of the six it is. policy_docs.zip is 24 KB of plain-text policy documents, and
# it is the corpus the whole of week 7 reads. Left out of git it depended entirely on a
# release asset that was never uploaded, which made W7D1-D4 unobtainable from a fresh
# clone. It is small enough to commit, so it is committed. See `make data-urls`.
!shared/data_cache/policy_docs.zip

# Hugging Face / torch model caches
.cache/
**/hf_cache/
**/torch_cache/

# Secrets — never commit an API key
.env
.env.*
!.env.example
*.pem
*.key

# Held-out assessment data (A3 test set). Instructor-only, kept outside git.
_holdout/

# Editors
.vscode/
.idea/
*.swp
*.swo

# Source PDFs for theory sessions. The ledger records where each one came from;
# the binaries themselves stay out of git. Put them in slides/sources/<session>/.
week_*/slides/sources/

# Theory pipeline output — regenerate with `make theory-all`.
# The Arabic slide scripts (slides/*.ar.md) and source ledgers (slides/*.sources.md)
# ARE text and ARE committed; the Word and PowerPoint files they build are not.
theory_docx/
theory_pptx/
*.docx
*.pptx
*.potx

# Archives / build output
*.zip
# ...except the one small text corpus that lives in a zip. This re-include has to come
# after the blanket *.zip rule, or git never sees it. See the note beside the data_cache
# rules above.
!shared/data_cache/policy_docs.zip
*.tar.gz
dist/
build/

# The generated student repo lives outside this tree, but guard against a stray copy
_student_repo/

# Lab output: the serving demo W8D1 writes beside its notebook
**/serving_demo/
